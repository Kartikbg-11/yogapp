    {
      "name": "3. Chant Sessions (Mantra Counter)",
      "item": [
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chant-sessions?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chant-sessions"],
              "query": [
                { "key": "limit", "value": "20", "description": "1–100, default 20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get active (resumable) session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chant-sessions?active=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chant-sessions"],
              "query": [
                { "key": "active", "value": "1" }
              ]
            },
            "description": "Returns the latest **unfinished** session updated within the last 24 h (`{ active: ChantSession | null }`) — used by the app to restore an interrupted counting session."
          },
          "response": []
        },
        {
          "name": "Create session (idempotent upsert)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('chantSessionId', body.session.id);",
                  "    console.log('✅ Session', body.session.id, '— count:', body.session.count, '/', body.session.target, '— saved to chantSessionId');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"postman-demo-0001\",\n  \"mantraName\": \"Om\",\n  \"target\": 108,\n  \"count\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/chant-sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chant-sessions"]
            },
            "description": "Creates a session, or **upserts by client `id`** (min 8 chars). Sending the same `id` twice updates the same row — safe against double-taps and offline replays.\n\n`target` clamped 27–1008 (27/54/108/216/1008) · `count` clamped 0–1008.\n\nReturns `201` on create, `200` on upsert. `milestones` array is populated when a completed action unlocks a badge."
          },
          "response": []
        },
        {
          "name": "Update count (absolute values)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 3,\n  \"durationSec\": 45\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/chant-sessions/{{chantSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chant-sessions", "{{chantSessionId}}"]
            },
            "description": "**Values are absolute, not increments** — always send the full current count. This makes duplicate/retried requests harmless. `count` is clamped ≥ 0."
          },
          "response": []
        },
        {
          "name": "Complete session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.milestones && body.milestones.length) {",
                  "    console.log('🏅 New milestones unlocked:', body.milestones.map(m => m.title).join(', '));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 108,\n  \"durationSec\": 900,\n  \"completed\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/chant-sessions/{{chantSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chant-sessions", "{{chantSessionId}}"]
            },
            "description": "Mark the mala round as complete. Check the console for newly unlocked milestone badges."
          },
          "response": []
        }
      ]
    },
