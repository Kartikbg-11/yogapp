# InnerPeace environment configuration
# Copy this file to .env and adjust as needed.
# NOTE: Prisma resolves relative `file:` URLs against prisma/schema.prisma,
# so ../db/custom.db points to <project-root>/db/custom.db.

DATABASE_URL=file:../db/custom.db

# Secret used to sign auth tokens (HMAC-SHA256). CHANGE THIS in production!
AUTH_SECRET=change-me-in-production
